{
    "namespace": "gaf-shop-v2",
    "main@common-mineville.form_template": {
        "$title_bindings": [
            {
        "binding_type": "view",
                "source_property_name": "(#title_text - '@mineville/gaf/v2:')",
                "target_property_name": "#text"
            }
        ],
        "$content_controls": [
            {
                "panel@gaf-shop-v2.form_content_panel": {}
            }
        ]
    },
    "form_content_panel": {
        "type": "panel",
        "controls": [
            {
                "scroll_panel@common.scrolling_panel": {
                    "$show_background": false,
                    "$scrolling_content": "gaf-shop-v2.scroll_content",
                    "$scroll_box_touch_image_control": "common-mineville.scroll_box_touch_image_control",
                    "$scroll_box_mouse_image_control": "common-mineville.scroll_box_mouse_image_control",
                    "$scroll_size": [
                        "5px",
                        "100% - 2px"
                    ],
                    "$scrolling_pane_size": [
                        "100%",
                        "100% - 10px"
                    ],
                    "$scrolling_pane_offset": [
                        0,
                        5
                    ],
                    "$scroll_bar_left_padding_size": [
                        0,
                        0
                    ],
                    "$scroll_bar_right_padding_size": [
                        "4px",
                        0
                    ]
                }
            }
        ]
    },
    "scroll_content": {
        "type": "stack_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [
            "100% - 20px",
            "100%c"
        ],
        "offset": [
            10,
            0
        ],
        "controls": [
            {
                "form_text_background@common.empty_image": {
                    "size": [
                        "100% + 5.5px",
                        "100%c + 10px"
                    ],
                    "texture": "textures/ui/common/light_field",
                    "layer": 4,
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "bindings": [
                        {
                    "binding_type": "view",
                            "source_property_name": "(not (#form_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "form_text_label": {
                                "layer": 5,
                                "offset": [
                                    5,
                                    0
                                ],
                                "type": "label",
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "text": "#form_text",
                                "shadow": true,
                                "max_size": [
                                    "100% - 8px",
                                    "default"
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "padding": {
                    "type": "panel",
                    "size": [
                        0,
                        "5px"
                    ],
                    "bindings": [
                        {
                    "binding_type": "view",
                            "source_property_name": "(not (#form_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "content": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": [
                        "100%",
                        "100%c"
                    ],
                    "controls": [
                        {
                            "main_content_panel@gaf-shop-v2.main_content_panel": {
                                "collection_name": "form_buttons"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "main_content_panel": {
        "type": "stack_panel",
        "size": [
            "100%",
            "100%c"
        ],
        "controls": [
