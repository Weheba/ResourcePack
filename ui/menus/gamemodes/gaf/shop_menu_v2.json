    "form_button": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [
            "100%",
            "36px"
        ],
        "collection_name": "form_buttons",
        "collection_index": "$shop_button_index",
        "bindings": [
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_text"
            },
            {
        "binding_type": "view",
                "source_property_name": "(not (#form_button_text = ''))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "form_button_image@gaf-shop-v2.form_button_image": {
                    "collection_index": "$shop_button_index"
                }
            },
            {
                "text_background": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/white/default",
                    "size": [
                        "60%",
                        "34px"
                    ],
                    "collection_index": "$shop_button_index",
                    "controls": [
                        {
                            "higher_text_panel": {
                                "type": "panel",
                                "size": [
                                    "100%c + 5px",
                                    10
                                ],
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "clips_children": true,
                                "offset": [
                                    2,
                                    -5
                                ],
                                "controls": [
                                    {
                                        "higher_text": {
                                            "type": "label",
                                            "text": "#form_button_text",
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle",
                                            "size": [
                                                175,
                                                20
                                            ],
                                            "color": "black",
                                            "bindings": [
                                                {
                                                    "binding_collection_name": "form_buttons",
                                                    "binding_name": "#form_button_text",
                                                    "binding_name_override": "#form_button_text",
                                                    "binding_type": "collection"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "lower_text_panel": {
                                "type": "panel",
                                "size": [
                                    "100%c +5px",
                                    10
                                ],
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "clips_children": true,
                                "offset": [
                                    2,
                                    "5px"
                                ],
                                "controls": [
                                    {
                                        "lower_text": {
                                            "type": "label",
                                            "text": "#form_button_text",
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle",
                                            "size": [
                                                175,
                                                20
                                            ],
                                            "offset": [
                                                0,
                                                -8
                                            ],
                                            "font_scale_factor": 0.8,
                                            "color": "black",
                                            "bindings": [
                                                {
                                                    "binding_collection_name": "form_buttons",
                                                    "binding_name": "#form_button_text",
                                                    "binding_name_override": "#form_button_text",
                                                    "binding_type": "collection"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "padding_bg_shop": {
                    "type": "panel",
                    "size": [
                        "2px",
                        "100%"
                    ]
                }
            },
            {
                "button@gaf-shop-v2.shop_button_buy": {
                    "collection_index": "($shop_button_index + 1)"
                }
            },
            {
                "padding_shop_minecoin": {
                    "type": "panel",
                    "size": [
                        "2px",
                        "100%"
                    ]
                }
            },
            {
                "button_minecoin@gaf-shop-v2.shop_button_buy_minecoin": {
                    "collection_index": "($shop_button_index + 2)"
                }
            }
        ]
    },
    "shop_button_buy_minecoin@common_buttons.light_text_button": {
        "size": [
            45,
            "34px"
        ],
        "$pressed_button_name": "button.form_button_click",
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ],
        "controls": [
            {
                "default": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/default",
                    "controls": [
                        {
                            "label@gaf-shop-v2.shop_button_buy_label": {}
                        }
                    ]
                }
            },
            {
                "hover": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/hover",
                    "controls": [
                        {
                            "label@gaf-shop-v2.shop_button_buy_label": {}
                        }
                    ]
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/pressed",
                    "controls": [
                        {
                            "label@gaf-shop-v2.shop_button_buy_label": {}
                        },
                        {
                            "overlay": {
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "alpha": 0.3,
                                "layer": 1
                            }
                        }
                    ]
                }
            },
            {
                "locked": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/pressed",
                    "controls": [
                        {
                            "label@gaf-shop-v2.shop_button_buy_label": {}
                        },
