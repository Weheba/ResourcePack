    "form_button@common.horizontal_stack_panel": {
        "size": [
            "100%",
            "40px"
        ],
        "collection_name": "form_buttons",
        "collection_index": "$shop_button_index",
        "bindings": [
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_text"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#form_button_text = ''))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "image@gaf-shop.form_button_image": {
                    "collection_index": "$shop_button_index"
                }
            },
            {
                "label@gaf-shop.form_button_info_stock": {
                    "$shop_button_info_index": "($shop_button_index +1)"
                }
            },
            {
                "padding@common.empty_panel": {
                    "size": [
                        "2px",
                        "100%"
                    ]
                }
            },
            {
                "button@gaf-shop.shop_button_buy": {
                    "collection_index": "($shop_button_index + 2)"
                }
            },
            {
                "padding_2@common.empty_panel": {
                    "type": "panel",
                    "size": [
                        "2px",
                        "100%"
                    ]
                }
            },
            {
                "button_plus_3@gaf-shop.shop_button_buy_minecoin": {
                    "collection_index": "($shop_button_index + 3)"
                }
            }
        ]
    },
    "shop_button_buy_minecoin": {
        "type": "button",
        "default_control": "default",
        "hover_control": "hover",
        "pressed_control": "pressed",
        "locked_control": "locked",
        "sound_name": "random.click",
        "focus_enabled": true,
        "size": [
            "15%",
            "35px"
        ],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ],
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.form_button_click",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.form_button_click",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "default": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/default",
                    "controls": [
                        {
                            "label@gaf-shop.shop_button_buy_minecoin_panel": {
                                "offset": [
                                    "-1px",
                                    "-1px"
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "hover": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/hover",
                    "controls": [
                        {
                            "label@gaf-shop.shop_button_buy_minecoin_panel": {
                                "offset": [
                                    "-1px",
                                    "-1px"
                                ]
                            }
                        },
                        {
                            "hover_text@common.hover_text": {
                                "layer": 200,
                                "property_bag": {
                                    "#hover_text": "Get from a Bundle now!"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/pressed",
                    "controls": [
                        {
                            "label@gaf-shop.shop_button_buy_minecoin_panel": {
                                "offset": [
                                    "-1px",
                                    "-1px"
                                ]
                            }
                        },
                        {
                            "overlay": {
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "alpha": 0.3,
                                "layer": 1
                            }
                        }
                    ]
                }
            },
            {
                "locked": {
                    "type": "image",
                    "texture": "textures/ui/common/buttons/red/pressed",
                    "controls": [
                        {
                            "label@gaf-shop.shop_button_buy_minecoin_panel": {
                                "offset": [
                                    "-1px",
                                    "-1px"
                                ]
                            }
                        },
                        {
                            "overlay": {
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "alpha": 0.3,
                                "layer": 1
                            }
                        }
                    ]
                }
            }
        ]
    },
    "shop_button_buy_minecoin_panel": {
        "type": "stack_panel",
        "orientation": "vertical",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [
            "100%",
            "100%c"
        ],
        "controls": [
            {
                "padding": {
                    "type": "panel",
                    "size": [
                        "100%",
                        "22px"
                    ]
                }
            },
            {
                "stack_panel": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": [
                        "100%",
                        "30px"
                    ],
                    "controls": [
                        {
                            "padding": {
                                "type": "panel",
                                "size": [
                                    "15px",
                                    "100%"
                                ]
                            }
                        },
                        {
                            "shop_button_buy_minecoin_label": {
                                "type": "label",
                                "text": "#text",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "layer": 1,
                                "color": [
                                    0.9,
                                    0.9,
                                    0.9
                                ],
                                "font_scale_factor": 0.7,
                                "bindings": [
                                    {
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons",
                                        "binding_name": "#form_button_text",
                                        "binding_name_override": "#text"
                                    }
                                ]
                            }
                        },
                        {
                            "icon": {
                                "type": "image",
                                "texture": "textures/ui/common/chest_closed",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "size": [
                                    "9px",
                                    "9px"
                                ],
                                "keep_ratio": true,
                                "layer": 2
                            }
                        }
                    ]
                }
            }
        ]
    },
