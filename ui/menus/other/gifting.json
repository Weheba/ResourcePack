{
    "namespace": "gifting",
    "main@common-mineville.form_template": {
        "$title_bindings": [
            {
                "binding_type": "view",
                "source_property_name": "(#title_text - '@mineville/gifting:')",
                "target_property_name": "#text"
            }
        ],
        "$content_controls": [
            {
                "panel@gifting.form_content_panel": {}
            }
        ]
    },
    "form_content_panel": {
        "type": "panel",
        "controls": [
            {
                "scroll_panel@common.scrolling_panel": {
                    "$show_background": false,
                    "$scrolling_content": "gifting.scroll_content",
                    "$scroll_box_touch_image_control": "common-mineville.scroll_box_touch_image_control",
                    "$scroll_box_mouse_image_control": "common-mineville.scroll_box_mouse_image_control",
                    "$scroll_size": [
                        "5px",
                        "100%  - 4px"
                    ],
                    "$scroll_bar_left_padding_size": [
                        "0px",
                        "0px"
                    ],
                    "$scrolling_pane_offset": [
                        0,
                        7
                    ],
                    "$scrolling_pane_size": [
                        "100%",
                        "100% - 12px"
                    ],
                    "$scroll_bar_right_padding_size": [
                        "5px",
                        "0px"
                    ]
                }
            }
        ]
    },
    "mv_button_controller_green@crate_preview_v2.mv_button_controller": {
        "$mc_texture": "textures/ui/common/gift",
        "controls": [
            {
                "button@crate_preview_v2.mv_button": {
                    "controls": [
                        {
                            "default@$mv_click_bindings": {
                                "ignored": "($hover_state or $pressed_state)",
                                "$button_texture": "('textures/ui/common/buttons/' + $button_color + '/default')"
                            }
                        },
                        {
                            "hover@$mv_click_bindings": {
                                "$hover_state": true,
                                "ignored": "($default_state or $pressed_state)",
                                "$button_texture": "('textures/ui/common/buttons/' + $button_color + '/hover')"
                            }
                        },
                        {
                            "pressed@$mv_click_bindings": {
                                "ignored": "($default_state or $hover_state)",
                                "$pressed_state": true,
                                "$button_texture": "('textures/ui/common/buttons/' + $button_color + '/pressed')"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "mv_dynamic_buttons@common.empty_image": {
        "size": [
            "100%",
            "100%"
        ],
        "layer": 2,
        "texture": "$button_texture",
        "controls": [
            {
                "texture_icon_mv@common.empty_image": {
                    "texture": "$mc_texture",
                    "layer": 10,
                    "$mc_texture|default": "",
                    "keep_ratio": true,
                    "size": [
                        28,
                        28
                    ],
                    "offset": [
                        4,
                        -1
                    ],
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "controls": [
                        {
                            "description_label_mv@gifting.text_common": {
                                "offset": [
                                    62,
                                    0
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "text_common": {
        "type": "label",
        "text": "BUY GIFTS TO SPEND",
        "font_type": "MinecraftTen",
        "alpha": 0.8,
        "font_scale_factor": 1,
        "color": "$shadow_color",
        "$shadow_color|default": [
            0.3,
            0.3,
            0.3
        ],
        "offset": [
            "0px",
            "-2px"
        ],
        "controls": [
            {
                "shadow": {
                    "font_scale_factor": 1,
                    "type": "label",
                    "text": "BUY GIFTS TO SPEND",
                    "font_type": "MinecraftTen",
                    "offset": [
                        "-1.2px",
                        "-1.2px"
                    ],
                    "color": "$color",
                    "$color|default": []
                }
            }
        ]
    },
