            },
            {
                "locked@common.empty_image": {
                    "texture": "textures/ui/common/buttons/common/pressed",
                    "controls": [
                        {
                            "label@gifting.shop_button_buy_label": {}
                        },
                        {
                            "overlay@common.empty_image": {
                                "texture": "textures/ui/Black",
                                "alpha": 0.3,
                                "layer": 1
                            }
                        }
                    ]
                }
            }
        ]
