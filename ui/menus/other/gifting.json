    "form_button": {
        "type": "collection_panel",
        "size": [
            "32.5%",
            92
        ],
        "collection_name": "form_buttons",
        "collection_index": "$shop_button_index",
        "bindings": [
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_text"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#form_button_text = ''))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "label@gifting.form_button_info_stock": {
                    "$shop_button_info_index": "($shop_button_index)"
                }
            },
            {
                "empty_panel@common.horizontal_stack_panel": {
                    "size": [
                        "100%",
                        27
                    ],
                    "collection_name": "form_buttons",
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "controls": [
                        {
                            "button_plus_1@gifting.shop_button_buy": {
                                "collection_index": "($shop_button_index + 1)"
                            }
                        },
                        {
                            "button_plus_2@gifting.shop_button_buy": {
                                "collection_index": "($shop_button_index + 2)"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "shop_button_buy@common.button": {
        "default_control": "default",
        "hover_control": "hover",
        "pressed_control": "pressed",
        "locked_control": "locked",
        "size": [
            "50%",
            25
        ],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ],
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.form_button_click",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.form_button_click",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "default@common.empty_image": {
                    "texture": "textures/ui/common/buttons/common/default",
                    "controls": [
                        {
                            "label@gifting.shop_button_buy_label": {}
                        }
                    ]
                }
            },
            {
                "hover@common.empty_image": {
