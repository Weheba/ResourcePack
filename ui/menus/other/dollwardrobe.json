{
    "namespace": "doll-wardrobe",
    "main@common-mineville.form_template": {
        "$title_bindings": [
            {
                "binding_type": "view",
                "source_property_name": "(#title_text - '@mineville/dollwardrobe:')",
                "target_property_name": "#text"
            }
        ],
        "$content_controls": [
            {
                "scroll_panel": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "controls": [
                        {
                            "cosmetic_tabs@common-mineville.cosmetic_tabs": {}
                        },
                        {
                            "first_padding": {
                                "type": "panel",
                                "size": [
                                    "0px",
                                    "5px"
                                ]
                            }
                        },
                        {
                            "form_text_wrapper": {
                                "type": "panel",
                                "size": [
                                    "100%",
                                    "100%c"
                                ],
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not (#form_text = ''))",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "form_text_background@common.empty_image": {
                                            "size": [
                                                "100% - 20px",
                                                "100%c + 10px"
                                            ],
                                            "texture": "textures/ui/common/light_field",
                                            "layer": 4,
                                            "offset": [
                                                0,
                                                0
                                            ],
                                            "controls": [
                                                {
                                                    "form_text_label": {
                                                        "layer": 5,
                                                        "offset": [
                                                            5,
                                                            0
                                                        ],
                                                        "type": "label",
                                                        "anchor_from": "left_middle",
                                                        "anchor_to": "left_middle",
                                                        "text": "#form_text",
                                                        "shadow": true,
                                                        "max_size": [
                                                            "100% - 8px",
                                                            "default"
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "scroll_panel": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": [
                                    "100%",
                                    "fill"
                                ],
                                "controls": [
                                    {
                                        "first_padding": {
                                            "type": "panel",
                                            "size": [
                                                5,
                                                0
                                            ]
                                        }
                                    },
                                    {
                                        "scroll_panel@common-mineville.skin_viewer_panel": {}
                                    },
                                    {
                                        "scroll_panel@common.scrolling_panel": {
                                            "$show_background": false,
                                            "$scrolling_pane_size": [
                                                "67% -9px",
                                                "100%"
                                            ],
                                            "$scrolling_pane_offset": [
                                                0,
                                                4
                                            ],
                                            "$scroll_size": [
                                                5,
                                                "100% -2px"
                                            ],
                                            "$scroll_bar_right_padding_size": [
                                                2,
                                                0
                                            ],
                                            "$scrolling_content": "doll-wardrobe.button_panel",
                                            "$scroll_box_touch_image_control": "common-mineville.scroll_box_touch_image_control",
                                            "$scroll_box_mouse_image_control": "common-mineville.scroll_box_mouse_image_control"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "bottom_padding": {
                                "type": "panel",
                                "size": [
                                    0,
                                    "13px"
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "button_panel": {
        "type": "panel",
        "size": [
            "100%",
            "100%c"
        ],
        "controls": [
            {
                "buttons_grid": {
                    "type": "grid",
                    "grid_item_template": "doll-wardrobe.form_button",
                    "collection_name": "form_buttons",
                    "grid_fill_direction": "horizontal",
                    "grid_rescaling_type": "horizontal",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "size": [
                        "100%",
                        "100%c"
                    ],
                    "bindings": [
                        {
                            "binding_condition": "once",
                            "binding_name": "((#form_button_length * 1) - 3)",
                            "binding_name_override": "#maximum_grid_items"
                        }
                    ]
                }
            }
        ]
    },
    "form_button@common.empty_panel": {
        "size": [
            "100%",
            34
        ],
        "controls": [
            {
                "button@common.button": {
                    "$pressed_button_name": "button.form_button_click",
                    "locked_control": "locked",
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_name": "#form_button_texture",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#form_button_text - '#locked') = #form_button_text)",
                            "target_property_name": "#enabled"
                        }
                    ],
                    "size": [
                        "100% - 2px",
                        32
                    ],
                    "controls": [
                        {
                            "default@doll-wardrobe.form_button_content": {
                                "$button_texture": "textures/ui/common/buttons/white/default"
                            }
                        },
                        {
                            "hover@doll-wardrobe.form_button_content": {
                                "$button_texture": "textures/ui/common/buttons/white/hover"
                            }
                        },
                        {
                            "pressed@doll-wardrobe.form_button_content": {
                                "$button_texture": "textures/ui/common/buttons/white/pressed"
                            }
                        },
                        {
                            "locked@doll-wardrobe.form_button_content": {
                                "$button_texture": "textures/ui/common/buttons/white/locked"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "form_button_content": {
        "type": "image",
        "size": [
            "100%",
            "100%"
        ],
        "texture": "$button_texture",
        "controls": [
            {
                "form_button_contents": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "controls": [
                        {
                            "image_panel": {
                                "type": "panel",
                                "size": [
                                    "100%y",
                                    "100%"
                                ],
                                "bindings": [
                                    {
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons",
                                        "binding_name": "#form_button_texture"
                                    },
                                    {
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons",
                                        "binding_name": "#form_button_texture_file_system"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not (#form_button_texture = ''))",
                                        "target_property_name": "#visible"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not (#form_button_texture = 'loading'))",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "layer": 1,
                                            "size": [
                                                "100% - 8px",
                                                "100% - 8px"
                                            ],
                                            "offset": [
                                                0,
                                                -1
                                            ],
                                            "keep_ratio": true,
                                            "bindings": [
                                                {
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons",
                                                    "binding_name": "#form_button_texture",
                                                    "binding_name_override": "#texture"
                                                },
                                                {
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons",
                                                    "binding_name": "#form_button_texture_file_system",
                                                    "binding_name_override": "#texture_file_system"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "label_panel": {
                                "type": "panel",
                                "size": [
                                    "fill",
                                    "100%"
                                ],
                                "controls": [
                                    {
                                        "label": {
                                            "type": "label",
                                            "text": "#text",
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "text_alignment": "center",
                                            "layer": 1,
                                            "color": [
                                                0.3,
                                                0.3,
                                                0.3
                                            ],
                                            "max_size": [
                                                "100%",
                                                "100%"
                                            ],
                                            "offset": [
                                                0,
                                                -0.5
                                            ],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(#form_button_text - '#locked')",
                                                    "target_property_name": "#text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}