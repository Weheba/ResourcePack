{
    "namespace": "common-mineville",
    "form_button": {
        "type": "panel",
        "$button_bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_texture",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#form_button_text - '#locked') = #form_button_text)",
                "target_property_name": "#enabled"
            }
        ],
        "$button_contents": [],
        "$hover_text_bindings": [],
        "$hover_text_controls": [],
        "$button_control_size": [],
        "$button_color": "common",        
        "$button_clicked": "button.form_button_click",
        "size": [
            "20px",
            "20px"
        ],
        "controls": [
            {
                "button_control@common.button": {
                    "default_control": "default",
                    "hover_control": "hover",
                    "pressed_control": "pressed",
                    "locked_control": "locked",
                    "size": "$button_control_size",
                    "$pressed_button_name": "$button_clicked",
                    "bindings": "$button_bindings",
                    "controls": [
                        {
                            "default": {
                                "type": "image",
                                "texture": "('textures/ui/common/buttons/' + $button_color + '/default')",
                                "controls": "$button_contents"
                            }
                        },
                        {
                            "hover": {
                                "type": "image",
                                "texture": "('textures/ui/common/buttons/' + $button_color + '/hover')",
                                "controls": [
                                    {
                                        "contents": {
                                            "type": "panel",
                                            "controls": "$button_contents"
                                        }
                                    },
                                    {
                                        "hover_text@common.hover_text": {
                                            "bindings": "$hover_text_bindings",
                                            "layer": 20,
                                            "controls": "$hover_text_controls"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "pressed": {
                                "type": "image",
                                "texture": "('textures/ui/common/buttons/' + $button_color + '/pressed')",
                                "controls": [
                                    {
                                        "contents": {
                                            "type": "panel",
                                            "controls": "$button_contents",
                                            "offset": [
                                                "0px",
                                                "1px"
                                            ]
                                        }
                                    },
                                    {
                                        "overlay": {
                                            "type": "image",
                                            "texture": "textures/ui/Black",
                                            "alpha": 0.3,
                                            "layer": 1
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "locked": {
                                "type": "image",
                                "texture": "('textures/ui/common/buttons/' + $button_color + '/pressed')",
                                "controls": [
                                    {
                                        "contents": {
                                            "type": "panel",
                                            "controls": "$button_contents",
                                            "offset": [
                                                "0px",
                                                "1px"
                                            ]
                                        }
                                    },
                                    {
                                        "overlay": {
                                            "type": "image",
                                            "texture": "textures/ui/Black",
                                            "alpha": 0.3,
                                            "layer": 1
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "mv_form_button_text@common-mineville.mv_label": {
        "text": "#text",
        "layer": 1,
        "bindings": [
            {
                "binding_name": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#form_button_text - '#locked')",
                "target_property_name": "#text"
            }
        ]
    },
    "mv_label": {
        "type": "label"
    },
    "mv_grid": {
        "type": "grid",
        "collection_name": "form_buttons",
        "grid_fill_direction": "horizontal",
        "grid_rescaling_type": "horizontal",
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "size": [
            "100%",
            "100%c"
        ],
        "bindings": [
            {
                "binding_condition": "once",
                "binding_name": "#form_button_length",
                "binding_name_override": "#maximum_grid_items"
            }
        ]
    },
    "mv_form_button_image@common.empty_image": {
        "layer": 1,
        "allow_debug_missing_texture": false,
        "bindings": [
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_texture",
                "binding_name_override": "#texture"
            },
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_texture_file_system",
                "binding_name_override": "#texture_file_system"
            }
        ]
    },
    "close_button@common.close_button": {
        "size": [
            "19px",
            "19px"
        ],
        "controls": [
            {
                "bg@common.empty_image": {
                    "layer": 2,
                    "texture": "textures/ui/common/buttons/common/default",
                    "controls": [
                        {
                            "cross@common.close_button_panel": {
                                "size": [
                                    "100% - 12px",
                                    "100% - 12px"
                                ],
                                "offset": [
                                    "0px",
                                    "-1px"
                                ],
                                "$close_button_texture": "textures/ui/common/cross"
                            }
                        }
                    ]
                }
            },
            {
                "hover@common.empty_image": {
                    "layer": 2,
                    "texture": "textures/ui/common/buttons/common/hover",
                    "controls": [
                        {
                            "cross@common.close_button_panel": {
                                "size": [
                                    "100% - 12px",
                                    "100% - 12px"
                                ],
                                "offset": [
                                    "0px",
                                    "-1px"
                                ],
                                "$close_button_texture": "textures/ui/common/cross"
                            }
                        }
                    ]
                }
            },
            {
                "pressed@common.empty_image": {
                    "layer": 2,
                    "texture": "textures/ui/common/buttons/common/pressed",
                    "controls": [
                        {
                            "cross@common.close_button_panel": {
                                "size": [
                                    "100% - 12px",
                                    "100% - 12px"
                                ],
                                "offset": [
                                    "0px",
                                    "-1px"
                                ],
                                "$close_button_texture": "textures/ui/common/cross"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "back_button_panel": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "collection_name": "form_buttons",
        "size": [
            "100%cm",
            "100%cm"
        ],
        "factory": {
            "name": "button_list_factory",
            "control_name": "common-mineville.button_list_entry"
        },
        "bindings": [
            {
                "binding_name": "#form_button_length",
                "binding_name_override": "#collection_length"
            },
            {
                "binding_name": "#title_text",
                "binding_type": "global"
            },
            {
                "binding_type": "view",
                "source_property_name": "(((#title_text - '@mineville/gaf_shop' - '@mineville/gaf/v2') = #title_text))",
                "target_property_name": "#visible"
            }
        ]
    },
    "cosmetic_tabs": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [
            "100%",
            25
        ],
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "factory": {
            "name": "button_list_factory",
            "control_name": "common-mineville.cosmetic_buttons"
        },
        "collection_name": "form_buttons",
        "bindings": [
            {
                "binding_name": "#form_button_length",
                "binding_name_override": "#collection_length"
            }
        ]
    },
    "cosmetic_buttons@common-mineville.form_button": {
        "size": [
            "33.4%",
            "100%"
        ],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_text",
                "binding_name_override": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#form_button_text - '§t§b§r') = #form_button_text))",
                "target_property_name": "#visible"
            }
        ],
        "$button_contents": [
            {
                "contents@city-menu-common.navigation_button_contents": {}
            }
        ]
    },
    "button_list_entry": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [
            "100%c",
            "100%cm"
        ],
        "controls": [
            {
                "padding": {
                    "type": "panel",
                    "size": [
                        "2px",
                        "0px"
                    ]
                }
            },
            {
                "button@common-mineville.form_button": {
                    "size": [
                        "19px",
                        "19px"
                    ],
                    "$button_contents": [
                        {
                            "back_arrow": {
                                "type": "image",
                                "texture": "textures/ui/common/back_symbol",
                                "size": [
                                    "100% - 12px",
                                    "100% - 12px"
                                ],
                                "offset": [
                                    "0px",
                                    "-1px"
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "bindings": [
            {
                "binding_type": "collection",
                "binding_collection_name": "form_buttons",
                "binding_name": "#form_button_text"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#form_button_text - '#back_button') = #form_button_text))",
                "target_property_name": "#visible"
            }
        ]
    },
    "empty_panel": {
        "type": "panel",
        "size": [
            "0px",
            "0px"
        ]
    },
    "field_button_template": {
        "type": "button",
        "$content_control": "common-mineville.empty_panel",
        "$visibility_keyword": "",
        "$background_texture": "light",
        "$label_scale_factor": 1.5,
        "$text_label": "",
        "size": [
            "30px",
            "30px"
        ],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_texture",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            }
        ],
        "controls": [
            {
                "contents": {
                    "type": "panel",
                    "clips_children": true,
                    "max_size": [
                        "100%",
                        "100%"
                    ],
                    "controls": [
                        {
                            "background@common-mineville.field_template": {
                                "$text": "#form_button_text",
                                "size": [
                                    "100%",
                                    "100%"
                                ]
                            }
                        },
                        {
                            "panel": {
                                "type": "panel",
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not ((#form_button_text - $visibility_keyword) = #form_button_text))",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "content@$content_control": {}
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "field_template": {
        "type": "panel",
        "$text": "",
        "$texture": "",
        "$localize_label": true,
        "$background_texture": "dark",
        "$label_scale_factor": 1.0,
        "size": [
            "15px",
            "15px"
        ],
        "min_size": [
            "15px",
            "15px"
        ],
        "controls": [
            {
                "background": {
                    "type": "image",
                    "texture": "#texture",
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#title_text - #title_text + 'textures/ui/common/' + $background_texture + '_field')",
                            "target_property_name": "#texture"
                        }
                    ]
                }
            },
            {
                "content": {
                    "type": "panel",
                    "size": [
                        "100%-2px",
                        "100%-2px"
                    ],
                    "controls": [
                        {
                            "label": {
                                "type": "label",
                                "text": "$text",
                                "shadow": true,
                                "localize": "$localize_label",
                                "font_scale_factor": "$label_scale_factor",
                                "font_size": "small",
                                "max_size": [
                                    "100%",
                                    "100%"
                                ]
                            }
                        },
                        {
                            "image": {
                                "type": "image",
                                "texture": "$texture"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "image_template": {
        "type": "panel",
        "controls": [
            {
                "image": {
                    "type": "image",
                    "bindings": [
                        {
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons",
                            "binding_name": "#form_button_texture",
                            "binding_name_override": "#texture"
                        },
                        {
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons",
                            "binding_name": "#form_button_texture_file_system",
                            "binding_name_override": "#texture_file_system"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "progress@progress.progress_loading_bars": {
                    "size": [
                        "50%",
                        "50%"
                    ],
                    "offset": [
                        "0px",
                        "0px"
                    ],
                    "bindings": [
                        {
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons",
                            "binding_name": "#form_button_texture"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#form_button_texture = 'loading')",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "form_template": {
        "type": "panel",
        "$content_controls": [],
        "$content_offset": [
            "0px",
            "4.5px"
        ],
        "$pc_size": [
            "330px",
            "200px"
        ],
        "$phone_size": [
            "330px",
            "160px"
        ],
        "size": [
            "100%cm",
            "100%cm"
        ],
        "$title_bindings": [
            {
                "binding_type": "view",
                "source_property_name": "(#text + 'Hello World!')",
                "target_property_name": "#text"
            }
        ],
        "controls": [
            {
                "stack_panel": {
                    "type": "stack_panel",
                    "size": [
                        "100%cm",
                        "100%c"
                    ],
                    "controls": [
                        {
                            "upper_bar": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": [
                                    "100%sm",
                                    "19px"
                                ],
                                "controls": [
                                    {
                                        "bar": {
                                            "type": "panel",
                                            "size": [
                                                "fill",
                                                "default"
                                            ],
                                            "controls": [
                                                {
                                                    "image": {
                                                        "type": "image",
                                                        "texture": "textures/ui/common/buttons/common/hover"
                                                    }
                                                },
                                                {
                                                    "content": {
                                                        "type": "panel",
                                                        "controls": [
                                                            {
                                                                "logo": {
                                                                    "type": "image",
                                                                    "texture": "textures/ui/title",
                                                                    "anchor_from": "right_middle",
                                                                    "anchor_to": "right_middle",
                                                                    "size": [
                                                                        "70px",
                                                                        "100%"
                                                                    ],
                                                                    "offset": [
                                                                        "-2px",
                                                                        "-1px"
                                                                    ]
                                                                }
                                                            },
                                                            {
                                                                "title": {
                                                                    "type": "label",
                                                                    "text": "#text",
                                                                    "anchor_from": "left_middle",
                                                                    "anchor_to": "left_middle",
                                                                    "font_type": "MinecraftTen",
                                                                    "font_scale_factor": 1.2,
                                                                    "localize": true,
                                                                    "bindings": "$title_bindings",
                                                                    "max_size": [
                                                                        "100% - 75px",
                                                                        "20px"
                                                                    ],
                                                                    "offset": [
                                                                        "4px",
                                                                        "-2px"
                                                                    ]
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "back_button_panel@common-mineville.back_button_panel": {}
                                    },
                                    {
                                        "padding": {
                                            "type": "panel",
                                            "size": [
                                                "2px",
                                                "0px"
                                            ]
                                        }
                                    },
                                    {
                                        "close_button@common-mineville.close_button": {}
                                    }
                                ]
                            }
                        },
                        {
                            "padding": {
                                "type": "panel",
                                "size": [
                                    "0px",
                                    "2px"
                                ]
                            }
                        },
                        {
                            "pc_form_content": {
                                "type": "panel",
                                "ignored": "$touch",
                                "size": [
                                    "100%cm",
                                    "100%cm"
                                ],
                                "min_size": [
                                    "150px",
                                    "170px"
                                ],
                                "max_size": [
                                    "340px",
                                    "210px"
                                ],
                                "controls": [
                                    {
                                        "background": {
                                            "type": "image",
                                            "texture": "textures/ui/common/background",
                                            "size": [
                                                "100%sm + 10px",
                                                "100%sm + 11px"
                                            ]
                                        }
                                    },
                                    {
                                        "contents": {
                                            "type": "panel",
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle",
                                            "layer": 1,
                                            "clips_children": true,
                                            "controls": "$content_controls",
                                            "offset": "$content_offset",
                                            "size": "$pc_size",
                                            "min_size": [
                                                "140px",
                                                "160px"
                                            ],
                                            "max_size": [
                                                "330px",
                                                "200px"
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "mobile_form_content": {
                                "type": "panel",
                                "ignored": "(not $touch)",
                                "size": [
                                    "100%cm",
                                    "170px"
                                ],
                                "min_size": [
                                    "225px",
                                    "150px"
                                ],
                                "max_size": [
                                    "340px",
                                    "170px"
                                ],
                                "controls": [
                                    {
                                        "background": {
                                            "type": "image",
                                            "texture": "textures/ui/common/background",
                                            "size": [
                                                "100%sm + 10px",
                                                "100%sm + 11px"
                                            ]
                                        }
                                    },
                                    {
                                        "contents": {
                                            "type": "panel",
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle",
                                            "layer": 1,
                                            "clips_children": true,
                                            "controls": "$content_controls",
                                            "offset": [
                                                "0px",
                                                "4.5px"
                                            ],
                                            "size": "$phone_size",
                                            "min_size": [
                                                "215px",
                                                "140px"
                                            ],
                                            "max_size": [
                                                "330px",
                                                "160px"
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "scroll_box_mouse_image_control": {
        "type": "image",
        "texture": "textures/ui/common/scroll_box",
        "layer": 3,
        "alpha": "@common.anim_scrollbar_box_fadeout"
    },
    "scroll_box_touch_image_control": {
        "type": "image",
        "texture": "textures/ui/common/scroll_box",
        "layer": 3,
        "alpha": "@common.anim_scrollbar_box_fadeout"
    },
    "skin_viewer_panel": {
        "type": "panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [
            "32%",
            "100%"
        ],
        "controls": [
            {
                "paper_doll_background": {
                    "type": "image",
                    "texture": "textures/ui/common/dark_field",
                    "size": [
                        "100% - 10px",
                        "100%"
                    ],
                    "offset": [
                        0,
                        5
                    ],
                    "controls": [
                        {
                            "defafult": {
                                "type": "custom",
                                "renderer": "live_player_renderer",
                                "layer": 2,
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "size": "$doll_size",
                                "$doll_size|default": [
                                    "60%",
                                    "80%"
                                ],
                                "variables": [
                                    {
                                        "requires": "($touch)",
                                        "$doll_size": [
                                            "40%",
                                            "60%"
                                        ],
                                        "$doll_offset": [
                                            0,
                                            -15
                                        ]
                                    }
                                ],
                                "property_bag": {
                                    "#look_at_cursor": true
                                },
                                "offset": "$doll_offset",
                                "$doll_offset|default": [
                                    0,
                                    -25
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}